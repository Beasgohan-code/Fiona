# Shared Telegram credentials
API_ID=0
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# One MongoDB URI is mapped to both feature packages; their database names stay separate.
MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Owner and logging
OWNER_ID=0
# Music diagnostics log destination; group/user events use it while the Music LOG switch is enabled.
LOGGER_ID=
# Optional shared Fiona audit-log destination: numeric -100... chat ID (or public @channelname).
# Lifecycle, new-user, and group membership events are sent here; same IDs are de-duplicated.
# Add the bot to the destination; grant post permission if it is a channel.
# Character uploads/submissions use CHARA_CHANNEL_ID, falling back to GLOG.
# Use a numeric Telegram chat ID (channels commonly start with -100) or public @username, never a phone number.
GLOG=
CHARA_CHANNEL_ID=

# Required for voice-chat playback: assistant user sessions, comma-separated.
STRING_SESSIONS=

# Health endpoints run inside the unified Music process; Render sets PORT.
# Health heartbeat freshness and watchdog warning cadence.
KEEP_ALIVE_MAX_AGE=120
KEEP_ALIVE_WATCHDOG_INTERVAL=30

# Low-rate best-effort public liveness ping (Render uses RENDER_EXTERNAL_URL).
# This does not override provider sleep limits; use an always-on plan for uptime.
KEEP_ALIVE_SELF_PING=true
KEEP_ALIVE_SELF_PING_INTERVAL=300
KEEP_ALIVE_PING_TIMEOUT=10
# Optional override; normally leave blank to use Render's automatic URL.
KEEP_ALIVE_PING_URL=

# Optional music integrations; supply all API keys privately (never commit them).
# Aoi Hosting Media API (JSON metadata, direct stream, and local download endpoints).
MEDIA_API_URL=https://host-repository.vercel.app
MEDIA_API_KEY=
# ShizuMusic downloader API: GET /download?url=<id>&type=audio|video&api_key=<key>.
# Legacy Shizu aliases API_URL/API_BASE/YT_API_URL and API_KEY/YT_API_KEY are also accepted.
SHIZUMUSIC_API_URL=
SHIZUMUSIC_API_KEY=
# Optional private Store channel for a Telegram-only persistent YouTube audio cache.
# Add Fiona as a member that can post; use a numeric -100... channel id. Leave blank to disable.
# If bot channel search is unavailable, the first assistant session must also be in the Store.
STORE_ID=
STORE_MAX_MB=45
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional Netscape cookies.txt path; read-only Render Secret Files are staged to writable runtime storage.
YT_COOKIES=
PROXY_URL=

# Optional support / channel links
SUPPORT_CHANNEL=
SUPPORT_GROUP=
SUPPORT_CHAT=
UPDATE_CHAT=

# Optional character-collection configuration
OWNER_USERNAME=
SUDO=
BACKUP_MONGO_URL=
DB_NAME=fiona
SUPPORT_CHAT_ID=
IMGBB_API_KEYS=
# Optional comma-separated start image/GIF/MP4 URLs; defaults rotate through bundled Fiona artwork.
START_MEDIA=
# Optional local-path or HTTPS artwork overrides; blank means use bundled assets.
WAIFU_START_IMAGE=
WAIFU_COLLECTION_IMAGE=
WAIFU_SHOP_IMAGE=
PHOTO_URL=
STATS_IMG=
# Music welcome/ping default to the bundled start image; blank uses that local asset.
START_IMG_URL=
PING_IMG_URL=

# ---------------------------------------------------------------------------
# OPTIONAL TUNING (appendix) — everything below is optional. Blank means use
# the code defaults (shown for reference); most deployments never need to set
# these. All values shown are the defaults, not secrets.
# ---------------------------------------------------------------------------

# --- Transport & workers ---
BOT_WORKERS=8
BOT_MAX_TRANSMISSIONS=4
ASSISTANT_WORKERS=4
ASSISTANT_MAX_TRANSMISSIONS=2
ASYNCIFY_WORKERS=8
# Pyrogram session string for the main bot instead of the cache/bot.session file; blank to use the file session.
BOT_SESSION_STRING=
# Leave the assistant in the voice chat until it is idle instead of leaving immediately.
AUTO_LEAVING_ASSISTANT=False
# Seconds the assistant waits before leaving an idle voice chat.
ASSISTANT_LEAVE_TIME=5800

# --- Playback limits ---
DURATION_LIMIT=5400
SONG_DOWNLOAD_DURATION_LIMIT=5400
VIDEO_STREAM_LIMIT=999
VOTE_SKIP_LIMIT=3
CLEANMODE_MINS=5
SERVER_PLAYLIST_LIMIT=235
PLAYLIST_FETCH_LIMIT=255
TG_AUDIO_FILESIZE_LIMIT=1073741824
TG_VIDEO_FILESIZE_LIMIT=1073741824
YOUTUBE_EDIT_SLEEP=3
TELEGRAM_EDIT_SLEEP=5
INSTANT_PLAY=True
# Disable public commands; OWNER_ID only.
PRIVATE_BOT_MODE=False
SET_CMDS=True

# --- Timed voice-chat lyrics ---
VC_LYRICS=True
VC_LYRICS_TITLE=True
VC_LYRICS_MESSAGE=False
VC_LYRICS_NOTES=True
VC_LYRICS_NOTES_SEC=30
VC_LYRICS_GAP_SEC=8
VC_LYRICS_MIN_SEC=2
VC_LYRICS_LANG=auto

# --- Health server, updater & one-off overrides ---
KEEP_ALIVE_HOST=0.0.0.0
KEEP_ALIVE_PORT=10000
SERVICE_NAME=
# Chromium path for web-page rendering; blank uses the bundled/autodetected browser.
WPC_BROWSER_PATH=
# Extra plugin autoloader (the unified launcher keeps this off).
EXTRA_PLUGINS=False
EXTRA_PLUGINS_REPO=
EXTRA_PLUGINS_FOLDER=plugins
GITHUB_REPO=
# Defaults to GITHUB_REPO; the self-updater watches this branch.
UPSTREAM_REPO=
UPSTREAM_BRANCH=main
GIT_TOKEN=
HEROKU_API_KEY=
HEROKU_APP_NAME=
PRIVACY_LINK=
# Testing-only Mongo fallback used when MONGO_DB_URI is unset; do not use in production.
TEMP_MONGO_DB_URI=

# --- Image asset overrides (blank = bundled Fiona artwork) ---
GLOBAL_IMG_URL=
PLAYLIST_IMG_URL=
YOUTUBE_IMG_URL=
STREAM_IMG_URL=
SOUNDCLOUD_IMG_URL=
STATS_IMG_URL=
TELEGRAM_AUDIO_URL=
TELEGRAM_VIDEO_URL=
# Legacy names rotated into the start carousel/cards when set; START_IMG_URL also still works.
PHOTO_URL_1=
PHOTO_URL_2=
SPOTIFY_ALBUM_IMG_URL=
SPOTIFY_ARTIST_IMG_URL=
SPOTIFY_PLAYLIST_IMG_URL=

# --- Legacy aliases (prefer the primary names above) ---
# TOKEN is a legacy alias of BOT_TOKEN; MONGO_URL is a legacy alias of MONGO_DB_URI.
TOKEN=
MONGO_URL=
# Single ImgBB key fallback for upload; IMGBB_API_KEYS (comma-separated) is preferred.
IMGBB_API_KEY=
# Path to the premium emoji mapping JSON; blank uses the bundled smart_emoji_db.json.
PREMIUM_EMOJI_DB=
