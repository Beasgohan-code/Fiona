# Shared Telegram credentials
API_ID=0
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# One MongoDB URI is mapped to both feature packages; their database names stay separate.
MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Owner and logging
OWNER_ID=0
# Music diagnostics log destination; group/user events use it while the Music LOG switch is enabled.
LOGGER_ID=
# Optional shared Fiona audit-log destination: numeric -100... chat ID (or public @channelname).
# Lifecycle, new-user, and group membership events are sent here; same IDs are de-duplicated.
# Add the bot to the destination; grant post permission if it is a channel.
# Character uploads/submissions use CHARA_CHANNEL_ID, falling back to GLOG.
# Use a numeric Telegram chat ID (channels commonly start with -100) or public @username, never a phone number.
GLOG=
CHARA_CHANNEL_ID=

# Required for voice-chat playback: assistant user sessions, comma-separated.
STRING_SESSIONS=

# Health endpoints run inside the unified Music process; Render sets PORT.
# Health heartbeat freshness and watchdog warning cadence.
KEEP_ALIVE_MAX_AGE=120
KEEP_ALIVE_WATCHDOG_INTERVAL=30

# Low-rate best-effort public liveness ping (Render uses RENDER_EXTERNAL_URL).
# This does not override provider sleep limits; use an always-on plan for uptime.
KEEP_ALIVE_SELF_PING=true
KEEP_ALIVE_SELF_PING_INTERVAL=300
KEEP_ALIVE_PING_TIMEOUT=10
# Optional override; normally leave blank to use Render's automatic URL.
KEEP_ALIVE_PING_URL=

# Optional music integrations; supply all API keys privately (never commit them).
# Aoi Hosting Media API (JSON metadata, direct stream, and local download endpoints).
MEDIA_API_URL=https://host-repository.vercel.app
MEDIA_API_KEY=
# ShizuMusic downloader API: GET /download?url=<id>&type=audio|video&api_key=<key>.
# Legacy Shizu aliases API_URL/API_BASE/YT_API_URL and API_KEY/YT_API_KEY are also accepted.
SHIZUMUSIC_API_URL=
SHIZUMUSIC_API_KEY=
# Optional private Store channel for a Telegram-only persistent YouTube audio cache.
# Add Fiona as a member that can post; use a numeric -100... channel id. Leave blank to disable.
# If bot channel search is unavailable, the first assistant session must also be in the Store.
STORE_ID=
STORE_MAX_MB=45
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional Netscape cookies.txt path; read-only Render Secret Files are staged to writable runtime storage.
YT_COOKIES=
PROXY_URL=

# Optional support / channel links
SUPPORT_CHANNEL=
SUPPORT_GROUP=
SUPPORT_CHAT=
UPDATE_CHAT=

# Optional character-collection configuration
OWNER_USERNAME=
SUDO=
BACKUP_MONGO_URL=
DB_NAME=fiona
SUPPORT_CHAT_ID=
IMGBB_API_KEYS=
# Optional comma-separated start image/GIF/MP4 URLs; defaults rotate through bundled Fiona artwork.
START_MEDIA=
# Optional local-path or HTTPS artwork overrides; blank means use bundled assets.
WAIFU_START_IMAGE=
WAIFU_COLLECTION_IMAGE=
WAIFU_SHOP_IMAGE=
PHOTO_URL=
STATS_IMG=
# Music welcome/ping default to the bundled start image; blank uses that local asset.
START_IMG_URL=
PING_IMG_URL=
